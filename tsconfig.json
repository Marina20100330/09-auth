{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node", // Изменил bundler на node для лучшей совместимости
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts", // БЫЛО: "/*.ts" (это ошибка)
    "**/*.tsx", // БЫЛО: "/*.tsx" (это ошибка)
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
